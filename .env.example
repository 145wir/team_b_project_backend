# ============================================
# Team B Backend
# ============================================

APP_NAME=Team B AI Paper Agent Backend
APP_ENV=development
API_PREFIX=/api/v1

# React/Vite local development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ============================================
# AWS RDS PostgreSQL
# ============================================

DB_HOST=team-b-rag-db.cf6y4g4uwyzd.ap-northeast-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=team_b_ai
DB_USER=postgres
DB_PASSWORD=team_b_ai

# AWS RDS
DB_SSLMODE=require

# Seconds
DB_CONNECT_TIMEOUT=10

# ============================================
# Retrieval
# ============================================

RETRIEVER_MODE=real
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_TOP_K=6