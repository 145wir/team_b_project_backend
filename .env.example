# ============================================
# Team B Backend
# ============================================

APP_NAME=Team B AI Paper Agent Backend
APP_ENV=development
API_PREFIX=/api/v1

# React/Vite local development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ============================================
# AWS RDS PostgreSQL
# ============================================

DB_HOST=your-rds-endpoint.ap-northeast-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=team_b_ai
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# AWS RDS
DB_SSLMODE=require

# Seconds
DB_CONNECT_TIMEOUT=10